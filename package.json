{
  "name": "notion-to-email",
  "version": "0.1.2",
  "description": "Convert Notion pages to email-compatible HTML",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@notionhq/client": ">=2.0.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.16.0",
    "@types/node": "^25.5.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sangkwun/notion-to-email.git"
  },
  "homepage": "https://github.com/Sangkwun/notion-to-email#readme",
  "license": "MIT",
  "keywords": [
    "notion",
    "email",
    "html",
    "converter",
    "notion-api"
  ],
  "engines": {
    "node": ">=18"
  }
}
